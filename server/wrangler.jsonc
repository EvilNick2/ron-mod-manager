{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ron-pack-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "OWNER_DISCORD_ID": "REPLACE_ME",
    "DISCORD_CLIENT_ID": "REPLACE_ME",
    "PUBLIC_URL": "https://packs.example.com",
    "STORAGE_CAP_BYTES": "20000000000",
    "MAX_USERS": "30",
    "OP_BUDGET": "900000",
    "R2_ACCOUNT_ID": "REPLACE_ME",
    "R2_BUCKET_NAME": "ron-packs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ron-packs",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PACKS", "bucket_name": "ron-packs" }],
  "ratelimits": [
    {
      "name": "USER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
